---
// src/components/CourseCard.astro

import ButtonLink from "./ButtonLink.astro"
interface Props {
	title: string
	author: string
	date: string
	progress: number
	image: string
	categories : string[]
}

const { title, author, date, progress, image, categories = [] } = Astro.props
---

<div class="flex flex-col overflow-hidden rounded-xl border border-secondary-100 bg-background shadow-sm h-full">
	<div class={`${image} h-28 flex items-center justify-center relative overflow-hidden group`}>
		<div class="absolute inset-0 bg-gradient-to-t from-secondary-900/15 to-transparent"></div>

		<div class="absolute top-2 left-2 flex flex-wrap gap-1 z-20 overflow-hidden">
			{categories.slice(0, 3).map((cat) => (
				<span class="px-2 py-0.5 bg-white/20 backdrop-blur-md border border-white/30 text-accent-100 text-[10px] font-bold uppercase tracking-wider rounded-full shadow-sm whitespace-nowrap">
               {cat}
           </span>
			))}
		</div>
	</div>

	<div class="flex flex-grow flex-col p-5 gap-3">

		<div class="flex items-center gap-2">
			<span class="text-primary-600 text-xs font-bold uppercase tracking-wide">{author}</span>
			<span class="text-secondary-300 text-xs">•</span>
			<span class="text-secondary-500 text-xs">{date}</span>
		</div>

		<h3 class="text-secondary-800 text-md font-bold leading-snug"
			style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
			{title}
		</h3>

		<div class="relative">
			<div class="h-4 w-full overflow-hidden rounded-full bg-secondary-100 shadow-sm">
				<div
					class="bg-primary-400 h-full rounded-full transition-all duration-500 ease-out"
					style={`width: ${progress}%`}
				>
				</div>
			</div>
			<p class="text-secondary-800 pointer-events-none absolute inset-0 z-10 flex items-center justify-center text-[10px] font-black tracking-wider">
				{progress}% COMPLETADO
			</p>
		</div>

			<ButtonLink href="" variant="secondary">
				<span>▶</span> Empezar curso
			</ButtonLink>
	</div>
</div>
