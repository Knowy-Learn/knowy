---
// TODO: Refactor to BEM with tailwind method using @apply in main.css for cleaner HTML markup.
import logo from "../assets/knowy.svg"
import menu from "../assets/icons/menu.svg"
import close from "../assets/icons/close.svg"
import ButtonLink from "./ButtonLink.astro"
---

<header class="bg-primary-500 sticky z-50 flex h-16 w-full items-center">
	<a
		href="/"
		class="text-accent-100 flex h-full w-1/2 items-center gap-2 p-4 text-xl font-bold"
		aria-label="Página principal"
	>
		<img src={logo.src} alt="Logo Knowy" class="h-11" />
		<span>Knowy</span>
	</a>

	{/* Desktop navigation */}
	<nav class="hidden w-1/2 items-end justify-end gap-3 px-10 py-4 md:grid md:grid-cols-2 lg:grid-cols-3">
		<div class="not-lg:hidden"></div>
		<ButtonLink href="/auth/login" variant="primary">Inicio Sesión</ButtonLink>
		<ButtonLink href="/auth/regist" variant="secondary">Registrarse</ButtonLink>
	</nav>

	{/* Mobile navigation */}
	<aside class="fixed top-0 right-0 z-50 flex h-16 w-full items-center justify-end bg-transparent md:hidden">
		{/* Button that open the menu */}
		<button
			id="menuButton"
			class="bg-primary-600 text-accent-100 z-50 m-4 flex h-12 w-12 cursor-pointer items-center justify-center rounded-md text-2xl shadow-lg transition-transform duration-200 active:scale-90"
		>
			<img id="menuBtnIcon" src={menu.src} alt="menu button" />
			<img id="menuBtnCloseIcon" src={close.src} alt="close menu button" class="hidden" />
		</button>

		{/* Menu content */}
		<nav
			id="mobileMenu"
			class="bg-primary-500/50 border-primary-700/30 shadow-secondary-500 fixed top-0 right-0 z-40 h-screen w-0 overflow-hidden border shadow-xl backdrop-blur-md transition-[width,background-color] duration-300"
		>
			<ul class="text-accent-100 mt-20 flex flex-col gap-2 text-2xl font-medium">
				<li>
					<a href="#" class="hover:bg-primary-600 block p-4 pl-8 transition-colors duration-200">
						Iniciar Sesión
					</a>
				</li>
				<li>
					<a href="#" class="hover:bg-primary-600 block p-4 pl-8 transition-colors duration-200">
						Registrarse
					</a>
				</li>
			</ul>
		</nav>
	</aside>
</header>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const btn = document.getElementById("menuButton") as HTMLButtonElement | null
		const menu = document.getElementById("mobileMenu") as HTMLElement | null

		const menuBtnIcon = document.getElementById("menuBtnIcon") as HTMLElement | null
		const menuCloseBtnIcon = document.getElementById("menuBtnCloseIcon") as HTMLElement | null

		let isOpen = false

		btn?.addEventListener("click", () => {
			isOpen = !isOpen
			isOpen ? openMenu() : closeMenu()
		})

		function openMenu() {
			if (!menu) return
			menu.style.width = "66%"
			menu.classList.remove("bg-transparent")
			menu.classList.add("bg-primary-500")

			menuBtnIcon?.classList.add("hidden")
			menuCloseBtnIcon?.classList.remove("hidden")
			return
		}

		function closeMenu() {
			if (!menu) return
			menu.style.width = "0"
			menu.classList.remove("bg-primary-500")
			menu.classList.add("bg-transparent")

			menuBtnIcon?.classList.remove("hidden")
			menuCloseBtnIcon?.classList.add("hidden")
		}
	})
</script>
