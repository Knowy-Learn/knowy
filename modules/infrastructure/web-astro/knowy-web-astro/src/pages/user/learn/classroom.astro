---
import NavbarUser from "src/components/user/NavbarUser.astro"
import Layout from "src/layouts/Layout.astro"
import Footer from "../../../components/Footer.astro"

// TODO: Delete placeholder
const bannerImage: string = "bg-orange-700"
const bannerText: string = "text-white"

const lessonTitles: string[] = [
	"Estructura básica de un documento HTML5",
	"Etiquetas de texto, listas y enlaces",
	"Multimedia: Imágenes, audio y video",
	"Formularios accesibles y funcionales",
	"Semántica y accesibilidad web"
]

const lessonPercent = 33
---

<Layout>
	<NavbarUser />

	<div class="classroom">
		{/* Sidebar: Lessons navigation and progress */}
		<aside class="classroom__aside">
			{/* Mobile drawer toggle handle */}
			<div class="drawer-handle group" data-drawer-trigger="main-drawer">
				<div class="drawer-handle__bar"></div>
			</div>

			<h2 class="classroom__aside--title">Introducción a HTML5</h2>

			{/* Course completion tracking */}
			<section class="progress-bar">
				<div class="progress-bar__header">
					<span>{lessonPercent}% completado</span>
				</div>

				<div class="progress-bar__track">
					<div class="progress-bar__fill" style={`width: ${lessonPercent}%`}></div>
				</div>

				<p class="progress-bar__stats">3 de 9 lecciones</p>
			</section>

			{/* Collapsible lesson list for mobile/desktop */}
			<section class="drawer-main" data-drawer-target="main-drawer" data-drawer-status="closed">
				<button class="lesson__btn_general-view">
					<span class="grid-icon"></span>
					Vista general
				</button>

				<section class="lesson">
					<h3 class="lesson__title">Lecciones</h3>

					<ul class="lesson__list">
						{
							lessonTitles.map((title) => (
								<li class="lesson__item group">
									<span class="check-icon" aria-hidden="true" />
									<p class="text-sm">{title}</p>
								</li>
							))
						}
					</ul>
				</section>
			</section>
		</aside>

		{/* Main content area */}
		<main class="classroom__main">
			<div class="classroom__content">
				{/* Course introduction banner */}
				<section class={`hero-banner ${bannerImage} ${bannerText}`}>
					<h1 class="text-3xl font-bold">Introducción a HTML5</h1>
					<p class="text-secondary600 text-lg leading-relaxed">
						Aprende los cimientos del desarrollo web moderno. Desde la estructura semántica hasta la
						integración de multimedia, domina las herramientas esenciales para crear sitios web
						profesionales y accesibles.
					</p>
				</section>

				<section class="content-body">
					{/* Brief overview of materials */}
					<div class="course-stats">
						<b>Contenido:</b>
						<div class="course-stats__item">📄 4 lecciones</div>
						<div class="course-stats__item">📝 14 ejercicios</div>
					</div>

					{/* Key learning objectives */}
					<div class="learning-container">
						<div class="learning-container__title">
							<span class="check-icon"></span>
							<h2 class="learning-container__title--text">Lo que aprenderás</h2>
						</div>

						<div class="learning-list">
							{
								lessonTitles.map((item) => (
									<div class="learning-list__item">
										<span class="check-icon" />
										<span>{item}</span>
									</div>
								))
							}
						</div>
					</div>
				</section>
			</div>

			{/* Drawer background overlay for mobile */}
			<div class="drawer-background" data-drawer-target="main-drawer" data-drawer-status="closed"></div>

			<Footer />

			{/* Spacing element for mobile footer visibility */}
			<div class="footer-lifter"></div>
		</main>
	</div>
</Layout>

<style>
	@import "./classroom.css";
</style>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		document.querySelectorAll("[data-drawer-trigger]").forEach(bindDrawerTrigger)
	})

	function bindDrawerTrigger(trigger: Element) {
		trigger.addEventListener("click", () => {
			const targetId = trigger.getAttribute("data-drawer-trigger")
			const target = document.querySelectorAll(`[data-drawer-target="${targetId}"]`)

			target.forEach(toggleDrawerStatus)
		})
	}

	function toggleDrawerStatus(drawer: Element) {
		const isOpen = drawer.getAttribute("data-drawer-status") === "open"
		drawer.setAttribute("data-drawer-status", isOpen ? "closed" : "open")
	}
</script>
