---
// TODO: Refactor to BEM with tailwind method using @apply in main.css for cleaner HTML markup.
import logo from "../../assets/knowy.svg"
import Layout from "../../layouts/Layout.astro"
import InputField from "../../components/InputField.astro"
---

<Layout>
	<main class="bg-background flex min-h-screen items-center justify-center">
		<section
			class="md:bg-accent-100/50 md:border-secondary-200 flex w-full max-w-md flex-col p-6 md:rounded-lg md:border md:shadow-lg"
		>
			<div class="my-2 flex w-full flex-col items-center">
				<a
					href="/"
					class="text-primary-500 flex items-center gap-2 text-2xl font-bold"
					aria-label="Página principal"
				>
					<img src={logo.src} alt="Logo Knowy" class="h-18" />
					<span>Knowy</span>
				</a>
			</div>

			<form class="flex w-full flex-col gap-5">
				<h1 class="text-primary-700 w-full text-center text-3xl font-semibold">Acceso temporal</h1>

				<p
					class="border-warning/40 bg-warning/10 text-secondary-700 flex items-start gap-2 rounded-md border p-3 text-sm"
				>
					<span class="text-warning text-lg">⚠️</span>
					<span>
						Esta cuenta temporal solo se mantendrá en este dispositivo y navegador durante
						<span class="text-warning font-semibold">7 días</span>.
					</span>
				</p>

				<InputField id="name" placeholder="knowy" label="Nombre de usuario" type="text" />

				<InputField id="password" placeholder="*******" label="Contraseña" type="password" />

				<InputField id="password-repeat" placeholder="*******" label="Repetir contraseña" type="password" />

				<button
					class="bg-primary-600 text-accent-100 hover:bg-primary-700 focus:ring-accent-600 rounded-md p-2 text-lg shadow-md transition-all duration-200 hover:scale-105 focus:ring-2"
					type="submit"
				>
					Entrar con acceso temporal
				</button>

				<div class="mt-2 flex flex-col items-center gap-2 text-center text-sm">
					<p class="text-secondary-500">
						¿Ya tienes una cuenta?
						<a href="/auth/login" class="text-primary-600 font-semibold hover:underline">
							Inicia sesión aquí
						</a>
					</p>

					<a
						href="/auth/regist"
						class="text-secondary-500 hover:text-primary-600 font-medium transition hover:underline"
					>
						¿Quieres registrarte?
					</a>

					<a href="/" class="text-secondary-400 hover:text-secondary-600 mt-1 text-xs hover:underline">
						← Volver a la web
					</a>
				</div>
			</form>
		</section>
	</main>
</Layout>
