---
import chvronDownIcon from "@icons/chevron-down.svg"

interface Props {
	id: string
	label: string
	options: OptionStatus[]
}

interface OptionStatus {
	name: string
	value: string
	text: string
}

const { id, label, options } = Astro.props
---

<div class="multi-select group">
	<input type="checkbox" id={id} class="multi-select__dropdown-status peer" />

	<label for={id} class="multi-select__label multi-select__label--color">
		<span class="multi-select__label--text">{label}</span>
		<img src={chvronDownIcon.src} alt="" aria-hidden="true" class="multi-select__label--icon" />
	</label>

	<div class="multi-select__option-container">
		{
			options?.map((option) => (
				<label class="multi-select__option">
					<input
						type="checkbox"
						name={option.name}
						value={option.value}
						class="multi-select__option-checkbox"
					/>
					<span class="multi-select__option-text">{option.text}</span>
				</label>
			))
		}
	</div>
</div>

<style>
	@reference "../styles/global.css";

	.multi-select {
		@apply relative w-full text-sm;
	}

	.multi-select__dropdown-status {
		@apply hidden;
	}

	.multi-select__label {
		@apply relative flex w-full items-center justify-between;
		@apply z-70 cursor-pointer appearance-none select-none;
		@apply rounded-lg border px-4 py-2.5;
		@apply text-sm font-medium;
		@apply transition-all duration-200;
		@apply peer-checked:shadow-md peer-checked:ring-2 peer-checked:outline-none;
	}

	.multi-select__label--color {
		@apply text-secondary-600 border-secondary-100 bg-white;
		@apply hover:border-accent-400;
		@apply peer-checked:border-primary-400 peer-checked:ring-primary-100/50;
	}

	.multi-select__label--text {
		@apply truncate;
	}

	.multi-select__label--icon {
		@apply pointer-events-none h-4 w-4 opacity-50 transition-transform duration-300 group-has-checked:rotate-180;
	}

	.multi-select__option-container {
		@apply absolute left-0 z-70 mt-1 hidden w-full space-y-1 rounded-md border border-gray-200 bg-white p-2 shadow-lg peer-checked:block;
	}

	/* Contenedor de la opción */
	.multi-select__option {
		@apply flex cursor-pointer items-center rounded p-2 transition-colors;
		@apply hover:bg-green-50;
	}

	/* El input checkbox */
	.multi-select__option-checkbox {
		@apply h-4 w-4 cursor-pointer rounded border-gray-300;
		@apply text-green-600 accent-green-600 focus:ring-green-500;
	}

	/* El texto de la opción */
	.multi-select__option-text {
		@apply ml-2 transition-colors;

		/* Cambio de color al hacer hover en la opción (usando el grupo) */
		.group\/item:hover & {
			@apply text-green-700;
		}
	}

	input[type="checkbox"] {
		@apply accent-primary-200;
	}
</style>
