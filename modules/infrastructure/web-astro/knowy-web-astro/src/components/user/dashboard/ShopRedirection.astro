---
// TODO: Refactor to BEM with tailwind method using @apply in main.css for cleaner HTML markup.
import logo from "@assets/knowy.svg"

interface Props {
	href: string | URL
}

const { href } = Astro.props
---

<a
	href={href}
	class="group border-primary-300 from-primary-100 via-primary-300 to-primary-100 relative h-[76px] min-h-[76px] cursor-pointer overflow-hidden rounded-lg border-4 bg-gradient-to-r px-6 transition-all duration-300"
>
	<img src={logo.src} alt="emote" class="pointer-events-none absolute top-1/12 right-2/24 h-24 w-24 opacity-15" />
	<div class="relative z-10 flex h-full w-full items-center justify-between">
		<span
			class="text-primary-800 ml-4 text-lg font-semibold transition-transform duration-500 group-hover:scale-110"
		>
			¡Únete a nuevos cursos!
		</span>

		<div class="flex h-full w-1/3 items-center justify-end overflow-hidden px-4">
			<span class="text-primary-600 transform text-4xl transition-transform duration-500 group-hover:scale-150">
				→
			</span>
		</div>
	</div>
</a>
