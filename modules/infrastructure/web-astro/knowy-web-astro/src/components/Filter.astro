---
import ButtonForm from "./ButtonForm.astro"
import filterIcon from "@icons/filter.svg"
import chvronDownIcon from "@icons/chevron-down.svg"

const selectClasses = "w-full cursor-pointer appearance-none rounded-xl border border-secondary-100 bg-white px-4 py-2.5 pr-10 text-sm font-medium text-secondary-600 transition-all duration-200 hover:border-accent-400 focus:border-primary-400 focus:ring-2 focus:ring-primary-100/50 focus:shadow-md focus:outline-none";
---

<form id="filter-form" class="relative mt-4 w-full rounded-2xl border border-secondary-100 bg-background p-4 shadow-lg">
	<div class="absolute -top-3 -left-5 flex h-9 w-9 items-center justify-center rounded-full border border-secondary-100 bg-background shadow-lg">
		<img src={filterIcon.src} alt="Filter Icon" class="h-5 w-5 object-contain opacity-40" />
	</div>

	<div class="flex flex-col items-center gap-4 lg:flex-row">
		<div class="flex w-full flex-col items-center gap-4 sm:flex-row lg:flex-1">

			<div class="group relative w-full">
				<label for="language-select" class="sr-only">Seleccionar categoría</label>
				<select id="language-select" name="language" class={selectClasses}>
					<option value="all">Todas las categorías</option>
				</select>
				<div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3">
					<img src={chvronDownIcon.src} alt="" aria-hidden="true" class="h-4 w-4 opacity-50 transition-transform duration-300 group-focus-within:rotate-180" />
				</div>
			</div>

			<div class="group relative w-full">
				<label for="order-select" class="sr-only">Seleccionar orden</label>
				<select id="order-select" name="order" class={selectClasses}>
					<option value="az">Alfabético A-Z</option>
					<option value="za">Alfabético Z-A</option>
				</select>
				<div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3">
					<img src={chvronDownIcon.src} alt="" aria-hidden="true" class="h-4 w-4 opacity-50 transition-transform duration-300 group-focus-within:rotate-180" />
				</div>
			</div>
		</div>

		<div class="flex w-full gap-3 lg:w-auto">
			<ButtonForm variant="primary" type="submit">Aplicar</ButtonForm>

			<ButtonForm variant="secondary" type="reset">
				<div class="flex items-center gap-2">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 stroke-primary-600" fill="none" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
					</svg>
					<span class="text-sm font-medium">Borrar</span>
				</div>
			</ButtonForm>
		</div>
	</div>
</form>