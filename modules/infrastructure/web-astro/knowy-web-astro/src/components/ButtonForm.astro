---
// TODO: Refactor to BEM with tailwind method using @apply in main.css for cleaner HTML markup.
/**
 * Reusable button link component.
 *
 * @component
 * @param {"primary" | "secondary" | "primaryGhost" } - Visual style variant.
 * @slot - Button content (text or elements inside the button).
 */
interface Props {
	variant?: "primary" | "secondary" | "primaryGhost"
	type?: "submit" | "reset"
}

const { variant = "primary", type } = Astro.props

const base = "rounded-lg font-medium w-full p-1 px-6 text-lg text-center transition-all duration-200 focus:ring-2"

const variants = {
	primary: "bg-primary-600 text-accent-100 hover:scale-102 hover:bg-primary-700 focus:ring-accent-600 shadow-md",
	primaryGhost: "text-accent-100 hover:scale-102 focus:ring-accent-600",
	secondary:
		"bg-accent-100 text-primary-600 ring-1 ring-primary-500 hover:bg-accent-200 hover:scale-102" +
		" focus:ring-accent-600 shadow-md"
}
---

<button class={`${base} ${variants[variant]}`} type={type}>
	<slot />
</button>
