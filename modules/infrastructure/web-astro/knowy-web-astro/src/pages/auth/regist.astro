---
import logo from "../../assets/knowy.svg"
import Layout from "../../layouts/Layout.astro"
import InputField from "../../components/InputField.astro"
---

<Layout>
	<main class="bg-background flex min-h-screen items-center justify-center">
		<section
			class="md:bg-accent-100/50 md:border-secondary-200 flex w-full max-w-md flex-col p-6 md:rounded-lg md:border md:shadow-lg"
		>
			<div class="my-3 flex w-full flex-col items-center">
				<a
					href="/"
					class="text-primary-500 flex items-center gap-2 text-2xl font-bold"
					aria-label="Página principal"
				>
					<img src={logo.src} alt="Logo Knowy" class="h-18" />
					<span>Knowy</span>
				</a>
			</div>

			<form class="flex w-full flex-col gap-5">
				<h1 class="text-primary-700 w-full text-center text-3xl font-semibold">Registro</h1>

				{/* Public fields */}
				<div class="flex flex-col gap-4 sm:flex-row">
					<InputField id="name" placeholder="knowy" label="Apodo / Nickname" type="text" />

					<div class="flex flex-col gap-1">
						<label for="gender" class="text-primary-700 font-medium">
							Género:
						</label>
						<select
							id="gender"
							name="gender"
							required
							class="bg-background border-primary-300/80 text-secondary-500 focus:border-accent-600 w-full rounded-lg border-2 px-3 py-3 focus:border-2 focus:ring"
						>
							<option value="" disabled selected>Selecciona tu género</option>
							<option value="male">Masculino</option>
							<option value="female">Femenino</option>
							<option value="other">Otro</option>
							<option value="prefer_not_say">Prefiero no decirlo</option>
						</select>
					</div>

				</div>

				{/* Separator */}
				<div class="w-full">
					<div class="border-primary-700 flex-grow border-t"></div>
				</div>

				{/* Private fields */}
				<InputField id="name" placeholder="knowy" label="Nombre de usuario" type="text" />

				<InputField id="email" placeholder="knowy@knowy.com" label="Correo electrónico" type="email" />

				<InputField id="password" placeholder="*******" label="Contraseña" type="password" />

				<InputField id="password-repeat" placeholder="*******" label="Repetir contraseña" type="password" />

				<button
					class="bg-primary-600 text-accent-100 hover:bg-primary-700 focus:ring-accent-600 rounded-md p-2 text-lg shadow-md transition-all duration-200 hover:scale-105 focus:ring-2"
					type="submit"
				>
					Registrarse
				</button>

				<div class="mt-2 flex flex-col items-center gap-2 text-center text-sm">
					<span class="text-secondary-500">
						¿Ya tienes una cuenta?
						<a href="/auth/login" class="text-primary-600 font-semibold hover:underline">
							Inicia sesión aquí
						</a>
					</span>

					<a href="/auth/guest" class="text-secondary-500 hover:text-primary-600 transition hover:underline">
						Probar con una cuenta temporal
					</a>

					<a href="/" class="text-secondary-400 hover:text-secondary-600 mt-1 text-xs hover:underline">
						← Volver a la web
					</a>
				</div>
			</form>
		</section>
	</main>
</Layout>
