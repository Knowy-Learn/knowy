---
const { id = "modalPassword" } = Astro.props;
import InputField from "src/components/InputField.astro";
---

<dialog id={id} class="backdrop:bg-secondary-900/40 m-auto max-h-[90vh] overflow-y-auto rounded-2xl border-none p-0 shadow-2xl backdrop:backdrop-blur-sm">
	<div class="w-[95vw] max-w-md bg-white p-8 outline-none">
		<h2 class="text-secondary-900 mb-2 text-xl font-bold">Cambiar contraseña</h2>
		<p class="text-secondary-500 mb-6 text-sm">Asegúrate de que sea una contraseña segura.</p>
		<form method="dialog" class="space-y-4">
			<InputField label="Contraseña actual" type="password" />
			<InputField label="Nueva contraseña" type="password" />
			<InputField label="Confirmar nueva contraseña" type="password" />
			<div class="mt-8 flex justify-end gap-3">
				<button
					type="button"
					class="text-secondary-500 hover:text-secondary-800 px-4 py-2 text-sm font-medium"
					onclick={`document.getElementById('${id}')?.close()`}
				>Cancelar</button>
				<button
					type="submit"
					class="bg-primary-500 hover:bg-primary-600 rounded-xl px-5 py-2.5 text-sm font-bold text-white transition-all active:scale-95"
				>Actualizar contraseña</button>
			</div>
		</form>
	</div>
</dialog>

