---
// src/components/CourseCard.astro
interface Props {
	title: string;
	author: string;
	date: string;
	progress: number;
	image: string;
}

const { title, author, date, progress, image } = Astro.props;
---
<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden flex flex-col">
	<div class={`${image} h-40 flex items-center justify-center relative`}>
		<div class="bg-white/20 p-4 rounded-lg backdrop-blur-sm border border-white/30">
			<span class="text-4xl font-bold text-white uppercase">{title.split(' ').pop()}</span>
		</div>
	</div>

	<div class="p-4 flex flex-col flex-grow">
		<p class="text-blue-600 font-medium text-sm">{author}</p>
		<p class="text-gray-400 text-xs mb-4">{date}</p>

		<div class="mt-auto">
			<p class="text-purple-600 text-xs font-bold mb-1">{progress}% completado</p>
			<div class="w-full bg-gray-200 rounded-full h-2 mb-4">
				<div class="bg-purple-500 h-2 rounded-full" style={`width: ${progress}%`}></div>
			</div>

			<h3 class="font-bold text-gray-800 mb-4">{title}</h3>

			<button class="w-full bg-[#4CAF50] hover:bg-[#45a049] text-white py-2 rounded-full transition-colors flex items-center justify-center gap-2">
				<span>▶</span> Empezar curso
			</button>
		</div>
	</div>
</div>