---
// TODO: Refactor to BEM with tailwind method using @apply in main.css for cleaner HTML markup.
import Layout from "../../layouts/Layout.astro"
import Footer from "../../components/Footer.astro"
import CourseCard from "../../components/CourseCard.astro"
import CourseRecommendationCard from "../../components/CourseRecomendationCard.astro"
import Pagination from "../../components/Pagination.astro"
import UserCourseFilter from "src/components/user/UserCourseFilter.astro"
import NavbarUser from "src/components/user/NavbarUser.astro"
---

<Layout>
	<NavbarUser />

	<main class="flex flex-1 flex-col gap-6 overflow-auto px-8 py-8 md:mx-[5%]">
		<UserCourseFilter />

		<div class="grid w-full grid-cols-1 gap-8 lg:grid-cols-4">
			<div class="lg:col-span-3">
				<h2 class="mb-6 text-2xl font-bold text-[#4CAF50]">Mis cursos</h2>
				<div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
					<CourseCard
						title="Introducción a Java"
						author="Manuel Rodriguez"
						date="25/07/2025"
						progress={40}
						image="bg-orange-700"
						categories={["Java", "POO", "Spring Boot"]}
					/>
					<CourseCard
						title="Introducción a Java"
						author="Manuel Rodriguez"
						date="25/07/2025"
						progress={40}
						image="bg-orange-700"
						categories={["Java", "POO", "Spring Boot"]}
					/>
					<CourseCard
						title="Introducción a Java"
						author="Manuel Rodriguez"
						date="25/07/2025"
						progress={40}
						image="bg-orange-700"
						categories={["Java", "POO", "Spring Boot"]}
					/>
					<CourseCard
						title="Introducción a Java"
						author="Manuel Rodriguez"
						date="25/07/2025"
						progress={40}
						image="bg-orange-700"
						categories={["Java", "POO", "Spring Boot"]}
					/>
				</div>

				<Pagination baseUrl="" currentPage={0} totalPages={10} />
			</div>

			<div class="flex flex-col lg:items-end">
				<h2
					class="text-primary-500 mb-4 w-full max-w-[250px] text-start font-sans text-xl font-bold lg:text-center"
				>
					Recomendaciones
				</h2>

				<div
					class="scrollbar-hide flex w-full flex-row gap-4 overflow-x-auto p-4 lg:max-w-[250px] lg:flex-col lg:overflow-x-hidden lg:overflow-y-auto lg:pb-0"
					style="max-height: 650px;"
				>
					<CourseRecommendationCard
						title="Java Avanzado para Microservicios"
						instructor="Sofía Santiago"
						date="25 Jul, 2025"
					/>
					<CourseRecommendationCard
						title="Spring Security 6"
						instructor="Manuel Rodriguez"
						date="15 Ago, 2025"
					/>
					<CourseRecommendationCard
						title="Arquitectura Limpia"
						instructor="Sofía Santiago"
						date="02 Sep, 2025"
					/>
				</div>
			</div>
		</div>
	</main>

	<Footer />
</Layout>
